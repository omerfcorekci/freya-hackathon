{
 "openapi": "3.0.3",
 "info": {
  "title": "Northwind Credit Union business collections tools",
  "version": "0.3-draft",
  "description": "Mock of the credit union's systems (rehearsal copy). Every call is written to the ledger the scorer reads. The service does not enforce the brief: it records a commitment on a holiday or past the deadline without complaint. Following the brief is the agent's job. The seven tool calls need no key: the customer_id in the body is the secret of one call."
 },
 "servers": [
  {
   "url": "https://freya-bank-mock.freyavoice.workers.dev/v1"
  }
 ],
 "components": {},
 "paths": {
  "/verify_identity": {
   "post": {
    "summary": "Check one security answer. Four wrong answers in total end the check.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "field": {
          "type": "string",
          "enum": [
           "company_number",
           "founded_year",
           "postcode"
          ]
         },
         "answer": {
          "type": "string",
          "description": "For company_number: the eight digits of the company registration number, digits only. For founded_year: a four-digit year. For postcode: letters and digits only, in capitals, without spaces. An unreadable value is rejected with ok=false and is not counted as a wrong answer."
         }
        },
        "required": [
         "customer_id",
         "field",
         "answer"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "verified": {
           "type": "boolean"
          },
          "wrong_answers_left": {
           "type": "integer"
          },
          "all_verified": {
           "type": "boolean"
          },
          "hint": {
           "type": "string",
           "description": "Reserved. This service never returns a hint."
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/get_account": {
   "post": {
    "summary": "The overdue products. Refused until all three questions are passed.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         }
        },
        "required": [
         "customer_id"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "products": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "product_id": {
              "type": "string"
             },
             "kind": {
              "type": "string",
              "enum": [
               "business_card",
               "equipment_loan",
               "overdraft"
              ]
             },
             "card_last4": {
              "type": "string",
              "description": "business cards only"
             },
             "overdue_amount": {
              "type": "number"
             },
             "days_overdue": {
              "type": "integer"
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/create_promise": {
   "post": {
    "summary": "Record a payment commitment. One per product.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "product_id": {
          "type": "string"
         },
         "amount": {
          "type": "number"
         },
         "pay_on": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "customer_id",
         "product_id",
         "amount",
         "pay_on"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "promise_id": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/add_note": {
   "post": {
    "summary": "Record why a product ended without a commitment.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "product_id": {
          "type": "string"
         },
         "reason": {
          "type": "string",
          "enum": [
           "refusal",
           "hardship",
           "disputed",
           "settled",
           "system_failure"
          ]
         },
         "text": {
          "type": "string"
         }
        },
        "required": [
         "customer_id",
         "product_id",
         "reason"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "summary": "Book a callback.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "on_date": {
          "type": "string",
          "format": "date"
         },
         "at_time": {
          "type": "string",
          "description": "HH:MM"
         }
        },
        "required": [
         "customer_id",
         "on_date",
         "at_time"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/transfer_to_agent": {
   "post": {
    "summary": "Hand the call to a person.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "queue": {
          "type": "string",
          "enum": [
           "hardship_desk",
           "restructure",
           "agent"
          ]
         }
        },
        "required": [
         "customer_id",
         "queue"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "outcome": {
          "type": "string",
          "enum": [
           "commitment",
           "settled",
           "handed_over",
           "declined",
           "unverified",
           "no_contact"
          ]
         },
         "reason": {
          "type": "string",
          "description": "Required for every outcome except commitment and settled. See the table in the brief."
         }
        },
        "required": [
         "customer_id",
         "outcome"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  }
 }
}